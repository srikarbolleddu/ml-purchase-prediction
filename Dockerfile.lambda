# Lambda container image — this is what CI actually deploys (see
# infra/README.md). Uses the AWS base image so the Lambda Runtime
# Interface Client is already wired up correctly.

FROM public.ecr.aws/lambda/python:3.13

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --format requirements-txt > requirements.txt \
    && pip install --no-cache-dir -r requirements.txt -t "${LAMBDA_TASK_ROOT}"

COPY app "${LAMBDA_TASK_ROOT}/app"

CMD ["app.lambda_handler.handler"]
